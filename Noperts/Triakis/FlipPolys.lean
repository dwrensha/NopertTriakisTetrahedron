  refine ⟨by decide, by decide, fun y => ?_⟩
  simp only [flipFP4, toIPoly, IPoly.toPoly, List.map, eval_cons, eval_nil, sgnI]
  simp only [flipPoly, flipLin, xPolyK, eval_add, eval_mul, eval_scale, eval_const, eval_wPoly, wVal]
  simp [flipCoeff, B0, F1, F2, sVal, tVal, monoEval, monoEvalFrom, eval_var, xPoly, eval_add,
    eval_mul, eval_scale, eval_const, sPoly, tPoly, M1, M2, M3, scalePoly, eval_scalePoly, scaleVal,
    skewK, atubeA, plainX, skewX, tubeX]
  ring

def flipFP (seg : Bool) (kind : ChartKind) (k : Fin 12) : Option FactPoly :=
  if seg = true ∧ kind = .askew ∧ k = 4 then some flipFP4 else
    if seg = false ∧ kind = .plain ∧ k = 4 then some flipFP3 else
    if seg = true ∧ kind = .aplain ∧ k = 4 then some flipFP2 else
    if seg = true ∧ kind = .plain ∧ k = 4 then some flipFP1 else
    if seg = true ∧ kind = .skew ∧ k = 4 then some flipFP0 else
    none

theorem flipFP_ok {seg : Bool} {kind : ChartKind} {k : Fin 12} {fp : FactPoly}
    (h : flipFP seg kind k = some fp) : FlipOk fp seg kind k := by
  unfold flipFP at h
  split_ifs at h <;> (try simp at h) <;> subst h
  all_goals (obtain ⟨rfl, rfl, rfl⟩ := ‹_›; first | exact flipFP0_ok | exact flipFP1_ok | exact flipFP2_ok | exact flipFP3_ok | exact flipFP4_ok)

end Noperts.Triakis.CornerKernel
