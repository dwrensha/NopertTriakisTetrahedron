def flipFP3 : FactPoly := ⟨[([0, 1, 0, 0, 0, 1], 4, true), ([0, 1, 1, 0, 1], 4, false), ([0, 2], 2, true), ([0, 2, 2], 1, true), ([1, 2, 1, 0, 0, 1], 2, false), ([1, 2, 2, 0, 1], 2, true), ([2, 2, 0, 0, 0, 2], 2, false), ([2, 2, 1, 0, 1, 1], 4, true), ([2, 2, 2, 0, 2], 2, false)], [2], 2⟩

