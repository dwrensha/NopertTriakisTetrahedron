def flipFP4 : FactPoly := ⟨[([0, 1, 0, 0, 1], 324, false), ([0, 1, 1, 0, 0, 1], 324, true), ([0, 1, 1, 0, 1], 792, false), ([0, 2], 81, true), ([0, 2, 2], 162, true), ([1, 2, 0, 0, 1], 162, true), ([1, 2, 1, 0, 0, 1], 162, false), ([1, 2, 1, 0, 1], 396, true), ([2, 2, 0, 0, 2], 162, false), ([2, 2, 1, 0, 1, 1], 324, true), ([2, 2, 1, 0, 2], 792, false), ([2, 2, 2, 0, 0, 2], 162, false), ([2, 2, 2, 0, 1, 1], 792, true), ([2, 2, 2, 0, 2], 968, false)], [2], 162⟩

