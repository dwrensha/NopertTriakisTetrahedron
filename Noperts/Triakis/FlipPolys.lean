module

public import Noperts.Triakis.FlipPolysBase

@[expose] public section

/-! Flip polynomial data for the flip leaves of the corner tables (generated by
`kernelCorner flippolys`). -/

namespace Noperts.Triakis.CornerKernel

open CornerPoly CornerTree SparsePoly FlipPrune

set_option maxHeartbeats 0
set_option linter.unusedSimpArgs false
set_option maxRecDepth 100000

def flipFP0 : FactPoly := ⟨[([0, 1, 0, 0, 1], 324, false), ([0, 1, 1, 0, 0, 1], 324, true), ([0, 1, 1, 0, 1], 792, false), ([0, 2], 81, true), ([0, 2, 2], 162, true), ([1, 2, 0, 0, 1], 162, true), ([1, 2, 1, 0, 0, 1], 162, false), ([1, 2, 1, 0, 1], 396, true), ([2, 2, 0, 0, 2], 162, false), ([2, 2, 1, 0, 1, 1], 324, true), ([2, 2, 1, 0, 2], 792, false), ([2, 2, 2, 0, 0, 2], 162, false), ([2, 2, 2, 0, 1, 1], 792, true), ([2, 2, 2, 0, 2], 968, false)], [2], 162⟩

theorem flipFP0_ok : FlipOk flipFP0 true .skew 4 := by
  refine ⟨by decide, by decide, fun y => ?_⟩
  simp only [flipFP0, toIPoly, IPoly.toPoly, List.map, eval_cons, eval_nil, sgnI]
  simp only [flipPoly, flipLin, xPolyK, eval_add, eval_mul, eval_scale, eval_const, eval_wPoly, wVal]
  simp [flipCoeff, B0, F1, F2, sVal, tVal, monoEval, monoEvalFrom, eval_var, xPoly, eval_add,
    eval_mul, eval_scale, eval_const, sPoly, tPoly, M1, M2, M3, scalePoly, eval_scalePoly, scaleVal,
    skewK, atubeA, plainX, skewX, tubeX]
  ring

